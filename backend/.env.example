# ==============================================================================
# LinguaMate AI - Backend Environment Variables
# Copy to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (Single Central Database & Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STORAGE_BUCKET=linguamate-files

# Google Gemini Intelligence
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.5-flash-lite

# JWT Authentication
JWT_SECRET=your_long_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# Speech Providers (Default: browser)
STT_PROVIDER=browser
TTS_PROVIDER=browser

# Optional External Providers (if configured)
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
